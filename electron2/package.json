{
  "name": "life-os",
  "version": "3.2.0",
  "description": "生命之花 · Life-OS — 把你的人生，画成一朵会呼吸的花",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts && node scripts/finalize-web.mjs",
    "deploy:pages": "npm run build:web && node scripts/sync-pages.mjs",
    "check:pages": "npm run build:web && node scripts/sync-pages.mjs --check",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "./e2e/run.sh dev",
    "e2e:prod": "./e2e/run.sh prod",
    "e2e:packaged": "./e2e/run.sh packaged",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.441.0",
    "openai": "^4.67.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.6.0",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "type": "module"
}
